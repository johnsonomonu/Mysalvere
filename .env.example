# Flutterwave webhook shared secret (set in Flutterwave dashboard)
FLUTTERWAVE_WEBHOOK_HASH=

# Supabase service role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for transactional emails
RESEND_API_KEY=

# Destination for operational alerts (webhook/email failures)
OPERATIONS_ALERT_EMAIL=ops@mysalvere.com

# Sender must be a verified domain/address in Resend
BOOKING_FROM_EMAIL=info@mysalvere.com
